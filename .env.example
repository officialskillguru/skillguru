# Canonical site URL (SEO/absolute links; fallback origin for auth email
# redirects outside a browser). Local: http://localhost:5173
# Production (Vercel env): https://skillguru-india.vercel.app
VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_NOTIFICATION_WEBHOOK_URL=
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
META_PIXEL_ID=
VITE_ENABLE_AUDIT_LOGS=false
VITE_STORAGE_COURSES=courses
VITE_STORAGE_MENTORS=mentors
VITE_STORAGE_SUCCESS=success-stories
VITE_STORAGE_ADMINS=admins
VITE_STORAGE_STUDENTS=students

# ── AI Resume Builder ────────────────────────────────────────────────────────
# Frontend (Vercel env). Keep "false" until migration
# 20261120000001_resume_builder_multi_resume.sql is applied; while false,
# /dashboard/resume-builder keeps serving the classic single-resume page.
VITE_RESUME_BUILDER_V2=false
#
# Supabase Edge Function secrets (supabase secrets set ...) - never VITE_*:
# GEMINI_API_KEY=                    # already used by converse/career-guidance
# GEMINI_RESUME_MODEL=gemini-flash-latest   # optional; falls back to GEMINI_MODEL
# RESUME_AI_PER_MINUTE=8             # optional per-student AI limits
# RESUME_AI_PER_DAY=80
# RESUME_PDF_WORKER_URL=             # Cloud Run worker base URL (unset = PDF disabled)
# RESUME_PDF_WORKER_SECRET=          # >= 32 random chars, same value on the worker
# RESUME_PDF_PER_DAY=30              # optional per-student PDF generations/day
# RESUME_PDF_VERSIONS_KEPT=5         # optional generated-PDF retention per resume
#
# Cloud Run worker env (services/resume-pdf-worker):
# RESUME_PDF_WORKER_SECRET=          # from Secret Manager
# RESUME_COMPILE_TIMEOUT_MS=20000
# RESUME_MAX_PAGES=4
