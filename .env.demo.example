# Local end-to-end simulation (counsellor -> student -> teacher).
#
# You normally do NOT create this by hand: `npm run demo:reset` writes the real
# `.env.demo.local` (git-ignored) from `npx supabase status`, including a
# generated DEMO_SIM_PASSWORD. This file only documents the variable names.
#
# `npm run dev:demo` runs Vite in "demo" mode, which loads .env.demo.local on top
# of .env, so these values override the production project URL/key in .env.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local anon key printed by `npx supabase status`>
VITE_SITE_URL=http://127.0.0.1:5180
VITE_DEMO_SIMULATION=true
VITE_RESUME_BUILDER_V2=true
DEMO_SIM_PASSWORD=<generated by the seed; shared by all simulation accounts>

# Edge Functions (supabase/functions/.env.demo.local, also generated):
# PAYMENT_PROVIDER=mock
# MOCK_PAYMENT_SECRET=<random, generated>
